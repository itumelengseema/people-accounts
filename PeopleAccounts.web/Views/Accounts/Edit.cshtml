@model PeopleAccounts.web.ViewModels.EditAccountViewModel

@{
    ViewData["Title"] = "Edit Account";
}

<h1>Edit Account</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Accounts"
              asp-action="Edit"
              asp-route-id="@Model.Code"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input asp-for="Code" type="hidden" />

            <div class="mb-3">
                <label asp-for="AccountNumber" class="form-label"></label>
                <input asp-for="AccountNumber"
                       class="form-control"
                       maxlength="50" />
                <span asp-validation-for="AccountNumber"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StatusCode" class="form-label"></label>

                <select asp-for="StatusCode" class="form-select">
                    <option value="1">Open</option>
                    <option value="2">Closed</option>
                </select>

                <span asp-validation-for="StatusCode"
                      class="text-danger"></span>

                <div class="form-text">
                    An account can only be closed when its balance is zero.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            <a asp-controller="Persons"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Persons
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}